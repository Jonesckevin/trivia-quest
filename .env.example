# Environment Variables Template

Copy this file to `.env` and update values for your environment.

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Application title displayed in UI and browser tab
APP_TITLE=Trivia Quest

# Path to SQLite database file
DATABASE_PATH=/data/questions.db

# ============================================================================
# SECURITY
# ============================================================================

# Admin password for administrative access
# IMPORTANT: Change this in production!
# Generate strong password: openssl rand -base64 32
ADMIN_PASSWORD=admin123

# Comma-separated list of allowed origins for CORS
# Examples: https://example.com,https://app.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable freeplay mode (no authentication required)
FREEPLAY=false

# Require user password (false = anyone can access)
REQUIRE_USER_PASSWORD=true
